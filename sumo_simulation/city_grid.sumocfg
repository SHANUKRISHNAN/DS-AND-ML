<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="city_grid.net.xml"/>
        <route-files value="city_grid.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>
    <processing>
        <device.emissions.probability value="1.0"/>
        <time-to-teleport value="300"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <duration-log.disable value="true"/>
    </report>
</configuration>